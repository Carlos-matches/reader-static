# 统一使用 LF 换行符。
#
# 这个项目里有 shell/配置文件，且会被 Netlify 的 Linux 构建环境执行。
# 如果被 Windows 的 CRLF 污染，可能出现 "bad interpreter" 之类的错误。

* text=auto eol=lf

*.ts    text eol=lf
*.js    text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.yml   text eol=lf

# 二进制
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.epub binary
*.zip  binary
*.woff binary
*.woff2 binary
